# Reinstalled / rebuilt inside the image — never ship from the host.
node_modules
**/node_modules
**/dist
# Local SQLite data (a Fly volume provides the production DB).
**/data/*.db
**/data/*.db-*
# VCS + noise
.git
.github
*.log
.DS_Store
# Session scratch + heavy non-runtime dirs.
scratchpad
**/scratchpad
# Local credentials, indexes and verification output are not runtime inputs.
.env
.env.*
**/.env
**/.env.*
.verify
.codegraph
.claude/worktrees
.impeccable/review
**/test-results
**/playwright-report
